  C: { name: "Background", emoji: "🟢" },
  D: { name: "Skip", emoji: "⚪" },
};

const individualCategories = [
  { id: "rushing", name: "Rushing Yards" },
  { id: "rushing-td", name: "Rushing TDs" },

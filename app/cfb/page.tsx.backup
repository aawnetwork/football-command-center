                                  upset
                                ) => (
                                  <div
                                    key={
                                      upset.gameId
                                    }
                                    style={{
                                      color:
                                        "#f87171",
                                      fontSize:
                                        "13px",
                                      fontWeight:
                                        900,
                                      marginBottom:
                                        "6px",
                                    }}
                                  >
                                    🚨{" "}
                                    {game.completed
                                      ? "UPSET"
                                      : "UPSET ALERT"}{" "}
                                    — #
                                    {
                                      upset.rank
                                    }{" "}
                                    {
                                      upset.rankedTeam
                                    }{" "}
                                    lost to{" "}
                                    {
                                      upset.opponent
                                    }{" "}
                                    {
                                      upset.result
                                    }
                                  </div>
                                )
                              )}

                            {rivalryGames
                              .filter(
                                (item) =>

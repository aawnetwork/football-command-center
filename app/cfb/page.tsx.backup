  ? selectedCategory === "total-defense" ||
selectedCategory === "rushing-defense" ||
selectedCategory === "passing-defense" ||
selectedCategory === "scoring-defense"
  ? `${leader.value.toLocaleString()} YPG`
  : formatStatValue(

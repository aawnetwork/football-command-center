                    );
                    const matchupIndicator = upsetSignal
                      ? {
                          label: `🚨 ${game.completed ? "UPSET" : "UPSET ALERT"} — #${upsetSignal.rank} ${upsetSignal.rankedTeam} lost to ${upsetSignal.opponent} ${upsetSignal.result}`,
                          color: "#f87171",

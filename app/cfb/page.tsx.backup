                              }
                            </div>

                            <div
                              style={{
                                color:
                                  "#cbd5e1",
                                marginTop:
                                  "6px",
                              }}
                            >
                              vs.{" "}
                              {
                                performance.opponent
                              }
                            </div>
                          </div>

                          <div
                            style={{
                              color:
                                "#fbbf24",
                              fontWeight:
                                800,
                              fontSize:
                                "16px",
                            }}

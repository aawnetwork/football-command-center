                            game.homeRank ||
                            game.awayRank
                              ? "1px solid #475569"
                              : "1px solid #1e293b",
                          borderRadius:
                            "12px",
                          padding:
                            "18px",
                        }}
                      >
                        <div
                          style={{
                            display:
                              "flex",
                            justifyContent:
                              "space-between",
                            gap: "16px",

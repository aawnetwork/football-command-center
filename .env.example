# Supabase project settings — server-only secret, never commit the real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Protects Vercel's Monday/Tuesday refreshes.
CRON_SECRET=

# Optional: protects manual POST requests to /api/all-time/refresh.
ALL_TIME_REFRESH_SECRET=

# Read-only Utility poll archive (server only; publishable key, never service role)
SUPABASE_POLL_READ_KEY=

# Optional GA4: remain disabled until stream settings and privacy wording are approved.
# Public measurement ID only; never place API secrets here. No active ID is supplied.
GA4_MEASUREMENT_ID=
AAW_ANALYTICS_ENABLED=false
# Requires manual page views, all Enhanced Measurement disabled, no connected tags/ads/Signals.
AAW_GA4_STREAM_APPROVED=false

# Temporary server-side tester gate, independent from private Admin credentials.
# Username aaw; set a unique password of at least 16 characters in hosting secrets.
AAW_INVITED_TESTING_ENABLED=false
AAW_TESTER_PASSWORD=
# Collection is independent from the invited-testing gate and does not change access.
AAW_AUDIENCE_PARTICIPATION_ENABLED=false
